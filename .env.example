# Hasło właściciela SaaS do panelu /admin (domyślnie w trybie lokalnym: admin2026)
ADMIN_PASSWORD=admin2026
# Tajny klucz do podpisywania sesji ciasteczek (zmień na własny losowy ciąg na produkcji!)
AUTH_SECRET=zmien-ten-klucz-na-dlugi-losowy-ciag-znakow

# Opcjonalna konfiguracja Stripe Connect + BLIK dla płatności produkcyjnych
# Jeśli zmienna pozostanie pusta, dla kont demo działa tryb symulacji BLIK
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
